{
  "name": "aud_audio_auv3",
  "summary": "Audio Unit v3 shell of the Audanika Audio Engine over its headless host, on macOS and iOS.",
  "domain": [
    "AUv3 shell (S20, plugin-011) on the shared core of aud_audio_plugin: parameters, factory presets, fullState, host MIDI 1.0 and UMP, the editor's notes as MIDI output, musical context and transport, offline rendering, sample cache budget per platform",
    "Editor inside the extension (plugin-012): the app's Flutter code at an entry point, FlutterEngineGroup on iOS, the shell protocol through dart:ffi (AudAuv3Shell)",
    "Build of a static library per platform, the extension's Info.plist and an xcconfig for an app's extension target without code; example app for macOS and iOS, test host, auval"
  ],
  "interfaces": {
    "uses": {
      "aud_audio_plugin": "package dependency; the engine, settings, state, transport, MIDI events, content lookup, plugin-build.js, the shell protocol's messages",
      "aud_audio_graph": "package dependency; the headless host in C",
      "aud_audio_core": "package dependency; the ABI headers, the SPSC ring"
    },
    "usedBy": {
      "audanika_app": "the AUv3 extension of the app on macOS and iOS: build-plugin.js, the static library, AudAuv3Shell in its editor"
    }
  }
}
